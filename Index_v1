<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KAYSONx Blueprint</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: sans-serif;
            padding: 20px;
        }

        .page-layout {
            display: grid;
            grid-template-columns: 180px 1fr 180px;
            gap: 20px;
            min-height: 90vh;
        }

        .left-merch-section,
        .main-section,
        .right-icon-section {
            border: 1px solid black;
            padding: 15px;
        }

        .section-title {
            border: 1px solid black;
            padding: 8px;
            margin-bottom: 15px;
            text-align: center;
            font-weight: bold;
        }

        .left-merch-section {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .merch-box {
            border: 1px solid black;
            height: 100px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .main-section {
            display: grid;
            grid-template-rows: 80px 1fr;
            gap: 20px;
        }

        .navigation-section {
            border: 1px solid black;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
        }

        .nav-box {
            border-right: 1px solid black;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .nav-box:last-child {
            border-right: none;
        }

        .artwork-section {
            border: 1px solid black;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
        }

        .right-icon-section {
            display: flex;
            flex-direction: column;
            gap: 40px;
        }

        .icon-box {
            border: 1px solid black;
            height: 120px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        @media (max-width: 900px) {
            .page-layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<div class="page-layout">

    <!-- LEFT MERCH SECTION -->
    <aside class="left-merch-section">

        <div class="section-title">Merch Section</div>

        <div class="merch-box">Pants</div>
        <div class="merch-box">Beanies</div>
        <div class="merch-box">Shirts</div>
        <div class="merch-box">Hoodies</div>

    </aside>


    <!-- MAIN SECTION -->
    <main class="main-section">

        <!-- NAVIGATION SECTION -->
        <nav class="navigation-section">

            <div class="nav-box">Home</div>
            <div class="nav-box">About</div>
            <div class="nav-box">Contact</div>
            <div class="nav-box">Spotify</div>

        </nav>

        <!-- ARTWORK SECTION -->
        <section class="artwork-section">
            Artwork
        </section>

    </main>


    <!-- RIGHT ICON SECTION -->
    <aside class="right-icon-section">

        <div class="section-title">Desktop Icon Section</div>

        <div class="icon-box">Explorer</div>
        <div class="icon-box">Music</div>
        <div class="icon-box">Finder</div>

    </aside>

</div>

</body>
</html>
